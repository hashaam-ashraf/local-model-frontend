server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Docker's DNS, looked up per request, so this container starts even when the api is down
    resolver 127.0.0.11 valid=10s;

    # The browser only ever talks to this server, so the api needs no CORS setup
    location /api/ {
        set $upstream http://${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;            # chat replies stream
        proxy_read_timeout 600s;        # a CPU model is slow; indexing embeds every page
        client_max_body_size 60m;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ =404;
    }
}
